# Copy this file to .env and edit it. Never commit .env.

# Session signing key — generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the SQLite database lives (absolute path recommended on the Pi)
DATABASE_PATH=/home/pi/pifinance/finance.db

# Port the app listens on
PORT=8080

# Interface the app binds to. Defaults to 127.0.0.1 (loopback only) in both the
# systemd unit and the dev server — a safe default that does NOT expose the home
# LAN. On the Pi, set this to the Tailscale IP so phones + the MCP client reach
# the app over the tailnet WITHOUT LAN exposure (P0-3 in the Aug-7 review):
#   BIND_HOST=100.108.237.13
# ⚠ If you leave this at 127.0.0.1 on the Pi, the phones cannot reach the app.
BIND_HOST=127.0.0.1

# --- Calendar subscribe over HTTPS (optional; deploy/calendar-https.md) ---
# The public HTTPS origin the calendar links are pinned to — the Tailscale-Serve
# front door, as scheme + host ONLY (no path). REQUIRED for the .ics subscribe to
# work: Apple rewrites webcal:// to https://, so a link mirroring the plain-HTTP
# request host can never subscribe. Unset (dev), links mirror the request host
# (fine locally, but the phone subscribe fails). A value with no scheme, or with
# a path, is ignored and falls back to request-mirroring.
#   PUBLIC_BASE_URL=https://raspberrypi.tail1234.ts.net
PUBLIC_BASE_URL=

# --- Deploy (optional; deploy/deploy.sh) ---
# After each deploy backs up finance.db, it prunes old finance.db.bak-* files
# down to the newest N so re-runs don't fill the SD card. Keep this BELOW the
# Ops guardian's MAX_BACKUPS warn threshold (default 12) so pruning stays under
# the alert. Default 10 if unset.
DEPLOY_KEEP_BACKUPS=10

# --- SimpleFIN sync (optional) ---
# File where the SimpleFIN access URL is stored by `simplefin_sync.py --claim`
SIMPLEFIN_ACCESS_FILE=/home/pi/pifinance/simplefin_access.url
# Which user id imported bank transactions are attributed to (1 = person one)
SYNC_PAID_BY=1
# How many days back each sync run looks (overlap is fine — dedupe handles it)
SYNC_LOOKBACK_DAYS=10

# --- MCP read tier (optional; AGENT-DESIGN) ---
# A 'read'-scope bearer token minted in Ledger settings (POST /api/tokens).
# The ledger_mcp process presents this to the local Flask app; never commit it.
LEDGER_MCP_TOKEN=
# The local Flask app the MCP server reads from.
LEDGER_API_BASE=http://127.0.0.1:8080
# Where the MCP server listens. Bind to the Pi's Tailscale IP for tailnet-only
# reach (no Funnel, no LAN exposure); 127.0.0.1 if fronting it with a tunnel.
# The transport has NO inbound auth — restrict the port to your own devices with
# a Tailscale ACL (deploy/mcp-tailnet-acl.md); binding beyond loopback logs a
# warning at startup.
LEDGER_MCP_HOST=127.0.0.1
LEDGER_MCP_PORT=8765
# The MCP write tier is OFF by default (safe): reads work, but every write is
# refused unless you opt in here — so a reachable port or a read,write token is
# not, by itself, enough to change data. Set to 1 to enable the write tools
# (classify, rules, pantry). Leave blank/unset for a read-only server.
LEDGER_MCP_ENABLE_WRITES=

# --- In-app Ask tab (optional; AGENT-DESIGN) ---
# Anthropic API key powering Charlee's in-app assistant (POST /api/ask).
# Per-query billing; keep it secret and never commit .env. Plain KEY=value,
# no quotes (systemd's EnvironmentFile reads this same file).
ANTHROPIC_API_KEY=
# Model for the Ask loop; Haiku 4.5 is the cost-fit default.
ASK_MODEL=claude-haiku-4-5
