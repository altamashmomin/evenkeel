# Pi Finance web app — /etc/systemd/system/pifinance.service
# Adjust User and paths if your username or install dir differs.
[Unit]
Description=Pi Finance web app
# When BIND_HOST is the Tailscale IP (P0-3), gunicorn can only bind once
# tailscaled has assigned it. Order after tailscaled + wait for the network so a
# reboot doesn't fail the bind; Restart=on-failure below is the backstop if the
# IP is still settling. (Harmless when BIND_HOST is empty / loopback-only.)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/pifinance
# Bind loopback (127.0.0.1) ALWAYS — Pi-local clients need it: the ledger-mcp
# sibling reaches Flask at LEDGER_API_BASE=http://127.0.0.1:8080, and deploy.sh's
# health check probes loopback. BIND_HOST adds ONE MORE interface: the Pi's .env
# sets it to the Tailscale IP so phones + the MCP client reach it over the
# tailnet. The home LAN interface is never bound, so P0-3 holds (loopback is
# Pi-only; the tailnet IP is tailnet-only; the LAN gets neither). Empty default
# = loopback only. Environment= before EnvironmentFile= so .env wins.
Environment=BIND_HOST=
EnvironmentFile=/home/pi/pifinance/.env
# --workers 4: the Pi 5 has 4 cores; 2 workers left the 13-endpoint analytics
# fan-out queueing and a single /api/ask (which holds a worker for the whole
# model loop) at 50% capacity. --timeout 120: the default 30s could kill a slow
# Ask request mid-flight (CODE-REVIEW-2026-08-07 #15). Tune down if the Pi is
# memory-constrained.
# sh -c so the shell adds the second --bind only when BIND_HOST is set; $$
# escapes systemd's own expansion so the SHELL expands ${...}. exec keeps
# gunicorn as the service's main process for clean signal handling.
ExecStart=/bin/sh -c 'exec /home/pi/pifinance/venv/bin/gunicorn --workers 4 --timeout 120 --bind 127.0.0.1:$${PORT} $${BIND_HOST:+--bind $${BIND_HOST}:$${PORT}} app:app'
Restart=on-failure
RestartSec=5

# Hardening (safe defaults for a home service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
